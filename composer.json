{
    "name": "turahe/ledger",
    "description": "A ledger management system for handling vouchers and invoices.",
    "license": "MIT",
    "authors": [
        {
            "name": "Nur Wachid",
            "email": "wachid@outlook.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "turahe/core": "^1.0",
        "turahe/master-data": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.17",
        "orchestra/testbench": "^10.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packagist.x-api.app"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Turahe\\Ledger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Turahe\\Ledger\\Database\\Factories\\": "database/factories",
            "Turahe\\Ledger\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "pint": "vendor/bin/pint --preserve-comments",
        "pint:check": "vendor/bin/pint --test --preserve-comments",
        "test": "vendor/bin/phpunit --testdox",
        "test:coverage": "vendor/bin/phpunit --coverage-html coverage --testdox",
        "test:coverage:clover": "vendor/bin/phpunit --coverage-clover=coverage.clover --testdox"
    },
    "extra": {
        "laravel": {
            "aliases": {},
            "providers": [
                "Turahe\\Ledger\\Providers\\LedgerServiceProvider"
            ]
        }
    }
}
