# Exclude test files from production releases
tests/ export-ignore
.phpunit.xml export-ignore
phpunit.xml export-ignore
pint.json export-ignore

# Exclude development and documentation files
.gitattributes export-ignore
.gitignore export-ignore
README.md export-ignore
CHANGELOG.md export-ignore
LICENSE export-ignore
CONTRIBUTING.md export-ignore

# Exclude CI/CD and development tools
.github/ export-ignore
.editorconfig export-ignore
.styleci.yml export-ignore

# Exclude coverage reports (already in .gitignore)
coverage/ export-ignore
*.clover export-ignore
coverage.xml export-ignore

# Exclude development dependencies
vendor/ export-ignore
composer.lock export-ignore

# Keep source code and essential files
src/ export
database/ export
config/ export
composer.json export
